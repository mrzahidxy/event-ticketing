# Project metadata
APP_NAME="Multi-Tenant Event Intelligence Platform"
APP_DESCRIPTION="Multi-tenant event intelligence platform"
JWT_ISSUER=event-ticketing

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=false

# Database
DATABASE_URL=
DIRECT_URL=

# Redis (optional in development; required in production for durable auth/session revocation)
REDIS_URL=redis://localhost:6379

APP_NAME="Event Ticketing"
APP_DESCRIPTION="Multi-tenant event ticketing platform"
JWT_ISSUER=event-ticketing

JWT_SECRET="replace-with-a-strong-secret-at-least-16-characters"
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_TOKEN_COOKIE_PATH=/api
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
JWT_AUDIENCE=

CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeMeAdmin1!
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=changeMeOwner1!
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=changeMeStaff1!
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=changeMeUser1!
