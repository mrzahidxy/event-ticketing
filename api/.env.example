# Project metadata
APP_NAME="event ticketing platfrom"
APP_DESCRIPTION="event ticketing platfrom"
JWT_ISSUER=event-ticketing-platfrom

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=false

# Database
DATABASE_URL="postgresql://ticketing_user:change_me_postgres_password@localhost:5433/ticketing_db?schema=public"
DIRECT_URL="postgresql://ticketing_user:change_me_postgres_password@localhost:5433/ticketing_db?schema=public"

# Docker Compose database defaults
POSTGRES_DB=ticketing_db
POSTGRES_USER=ticketing_user
POSTGRES_PASSWORD=change_me_postgres_password
DB_PORT=5433

# Redis (optional in development; required in production for durable auth/session revocation)
REDIS_URL=redis://localhost:6380

# JWT
JWT_SECRET="replace-with-a-strong-secret-at-least-16-characters"
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refreshToken
REFRESH_TOKEN_COOKIE_PATH=/api
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
JWT_AUDIENCE=

# CORS (list explicit origins; wildcards are rejected in production)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Stripe (optional, leave empty to disable)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Seed data
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeMeAdmin1!
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=changeMeOwner1!
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=changeMeStaff1!
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=changeMeUser1!

# Cloudinary (optional, leave empty to disable)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload
MAX_UPLOAD_SIZE=5242880
