NODE_ENV=production

# App metadata
NEXT_PUBLIC_APP_NAME=Multi-Tenant Event Intelligence Platform
NEXT_PUBLIC_APP_DESCRIPTION=Multi-tenant event intelligence platform

# Frontend / Auth
NEXTAUTH_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
API_INTERNAL_BASE_URL=http://api:4000
NEXTAUTH_SECRET=replace-with-strong-random-secret
AUTH_SECRET=replace-with-strong-random-secret

# API
HOST=0.0.0.0
PORT=4000
APP_NAME=Multi-Tenant Event Intelligence Platform
APP_DESCRIPTION=Multi-tenant event intelligence platform
JWT_SECRET=replace-with-strong-random-secret

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=event_ticketing
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:replace-with-strong-db-password@postgres:5432/event_ticketing
DIRECT_URL=postgresql://postgres:replace-with-strong-db-password@postgres:5432/event_ticketing

# Redis
REDIS_URL=redis://redis:6379

# CORS
CORS_ORIGIN=https://your-domain.com,https://api.your-domain.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Docker images
DOCKERHUB_USERNAME=your-dockerhub-username